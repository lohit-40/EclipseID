pragma language_version >= 0.14.0;
import CompactStandardLibrary;

export ledger issuers: Map<Bytes<32>, Boolean>;
export ledger used_nullifiers: Map<Bytes<32>, Boolean>;

export struct UserAttributes {
    secret_id: Bytes<32>,
    is_accredited: Boolean,
    age: Uint<8>
}

// The private witness representing the user's secret identity and attributes.
// SECURITY: Kept entirely off-chain. Selective disclosure proves attributes without leaking the origin data.
witness user_credential(): UserAttributes;

export circuit add_issuer(issuer: Bytes<32>): [] {
    issuers.insert(disclose(issuer), true);
}

// ZK Circuit 1: Darkpool Access (Requires is_accredited == true)
export circuit enter_darkpool(
    issuer: Bytes<32>,
    nullifier: Bytes<32>
): [] {
    assert(issuers.member(disclose(issuer)), "Issuer not authorized");
    
    // Selective Disclosure: Prove accreditation without revealing age or secret_id
    assert(user_credential().is_accredited, "User is not an accredited investor");
    
    // Nullifier derivation check (simplified)
    assert(user_credential().secret_id != nullifier, "Secret identity cannot equal nullifier");
    assert(!used_nullifiers.member(disclose(nullifier)), "Identity already verified/used");
    used_nullifiers.insert(disclose(nullifier), true);
}

// ZK Circuit 2: Age-Gated Airdrop (Requires age >= 18)
export circuit claim_age_gated_airdrop(
    issuer: Bytes<32>,
    nullifier: Bytes<32>
): [] {
    assert(issuers.member(disclose(issuer)), "Issuer not authorized");
    
    // Selective Disclosure: Prove age >= 18 without revealing exact age or accreditation
    assert(user_credential().age >= 18, "User is not over 18");
    
    assert(user_credential().secret_id != nullifier, "Secret identity cannot equal nullifier");
    assert(!used_nullifiers.member(disclose(nullifier)), "Identity already verified/used");
    used_nullifiers.insert(disclose(nullifier), true);
}
